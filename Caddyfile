{
	admin off
}

# Railway terminates TLS at its edge and forwards plain HTTP to $PORT.
# Routing protocol: see ROUTING.md.
:{$PORT:8080} {
	encode gzip

	@probes path /.env* /.git* /wp-* *.php /admin/*
	respond @probes 403

	handle /health {
		respond "ok" 200
	}

	handle /v1/* {
		reverse_proxy {$CORE_API_UPSTREAM}
	}

	handle /bridge/* {
		reverse_proxy {$BRIDGE_UPSTREAM}
	}

	handle {
		respond "Not Found" 404
	}
}
