# Vox environment reference: every variable vox-core and vox-bridge read.
#
# Services
#   core-api, core-worker  (vox-core): both load the same Config, so give them the same variables.
#   bridge                 (vox-bridge): phone, WhatsApp and voice pipeline.
#
# Legend
#   [required]  startup or the feature fails without it
#   [optional]  has a default shown, or simply turns a feature off when unset
#
# Put real values in an ignored .env or the platform's secret store, never in git.
# The two services share one secret: VOX_AUTH_TOKEN must be identical in core and bridge.


# =============================================================================
# Shared by core and bridge
# =============================================================================

# [required] Service-to-service bearer token. Generate with: openssl rand -hex 32
VOX_AUTH_TOKEN=

# Same name and same meaning in both services, so one value serves both. Each key appears
# once in this file; do not repeat it in the service sections below.
# [optional] Jev fast classifier. Core: event triage and tool routing. Bridge: filler choice
# and end-of-turn detection (the bridge also accepts the alias TYPESAFE_API_KEY, which wins).
# Unset disables Jev.
JEV_API_KEY=
# [optional] elevenlabs (default) or sarvam. Core's voice socket uses ElevenLabs; the bridge also
# supports sarvam, in which case SARVAM_API_KEY is required there.
VOX_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Defaults: voice 21m00Tcm4TlvDq8ikWAM, model eleven_v4_turbo, format mp3_44100_128
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_OUTPUT_FORMAT=
# AssemblyAI. [required] by the bridge (streaming speech-to-text). [optional] in core, where it
# enables speech-to-text on the voice socket.
ASSEMBLYAI_API_KEY=


# =============================================================================
# vox-core: core-api and core-worker
# =============================================================================

# --- Core runtime ------------------------------------------------------------
# [required] Postgres direct connection (not a transaction pooler: sqlx uses named
# prepared statements). On Railway with Supabase, enable Outbound IPv6.
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# [optional] Default 10 / 5
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
# [optional] Default redis://redis:6379
REDIS_URL=redis://redis:6379
# [optional] Default 0.0.0.0:3001. If unset, 0.0.0.0:$PORT is used (Railway sets PORT).
VOX_CORE_BIND_ADDRESS=0.0.0.0:3001
# PORT is also read by the bridge (default 3000), so it is not set here. Platforms such as
# Railway inject it per service; core only uses it when VOX_CORE_BIND_ADDRESS is unset.
# [optional] Bridge base URL. Needed by core-worker for outbound calls and by core-api to send
# phone verification codes. On the API service this MUST be set or verification returns 503.
VOX_BRIDGE_URL=http://bridge:3000
# [optional] core-api base URL, used by the worker.
VOX_CORE_API_URL=http://core-api:3001

# --- AI models and tools -----------------------------------------------------
# [required]
GEMINI_API_KEY=
EXA_API_KEY=
# [optional] Default gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# [optional] Places and routes tools; location ingestion
GOOGLE_MAPS_API_KEY=
# [optional] Default https://api.typesafe.ai/v1/systemone (JEV_API_KEY is in the shared section)
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# --- Voice socket (desktop and mobile talk-to-Vox) ---------------------------
# Uses the shared ELEVENLABS_* and ASSEMBLYAI_API_KEY above; voice is unavailable when unset.
# Core uses ASSEMBLYAI_SPEECH_MODEL for batch transcription, but the bridge reads the same name
# for streaming with different valid values (default universal-3-5-pro). Set it per service, never
# in a shared env file. Core default "best" is sent as no model, so AssemblyAI picks its default.
# ASSEMBLYAI_SPEECH_MODEL=

# --- Sign-in and API access (core-api) ---------------------------------------
# Supabase access tokens: HS256 projects use the JWT secret; asymmetric (ES256/RS256) projects use the URL.
SUPABASE_JWT_SECRET=
SUPABASE_URL=
# Alias accepted instead of SUPABASE_URL: VOX_SUPABASE_URL (set only one).
# VOX_SUPABASE_URL=
# [optional] Audience for direct Google ID tokens; Google sign-in is rejected when unset.
GOOGLE_OAUTH_CLIENT_ID=
# [optional] Extra browser origins allowed by CORS, comma separated ("*" is ignored).
VOX_CORS_ALLOWED_ORIGINS=
# [optional] Default 100 requests per 60 seconds per client.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECS=60
# [optional] Credential for the protected admin routes. Keep separate from VOX_AUTH_TOKEN.
VOX_ADMIN_TOKEN=
# [optional] Comma-separated VOX_HOST_CREDENTIAL_ID values of bridges trusted to link phone
# callers to signed-in accounts (name, history, summaries). Unset means callers stay anonymous.
VOX_TRUSTED_CHANNEL_CREDENTIAL_IDS=

# --- Connected apps and secrets ----------------------------------------------
# [optional] 32-byte hex key (openssl rand -hex 32) that encrypts status webhook secrets.
VOX_STATUS_WEBHOOK_KEY=
# [optional] Encryption key for stored connected-app tokens. Back it up: replacing it makes
# existing encrypted tokens unreadable.
VOX_CREDENTIAL_KEY=
# [optional] Comma-separated OAuth callbacks allowed for connected-app sign-ins.
VOX_MCP_OAUTH_REDIRECT_URIS=
# [optional] JSON map of MCP endpoint host -> OAuth client, for apps without dynamic registration.
VOX_MCP_OAUTH_CLIENTS=

# --- Event agent and email (core-worker) -------------------------------------
# [optional] SMTP for emails to the user's own Google address; notify_user fails without them.
VOX_SMTP_URL=smtps://user:password@smtp.example.com:465
VOX_EMAIL_FROM=Vox <hello@voxagent.in>
# [optional] Set to false or 0 to stop the agent acting on plan_action events. Default true.
VOX_EVENT_AGENT_ENABLED=true

# --- Observability (optional) ------------------------------------------------
# Langfuse agent traces. Leave the keys empty to disable. EU cloud by default.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# true also sends prompts, replies and tool arguments/results (names, addresses, phone numbers).
LANGFUSE_RECORD_CONTENT=false
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=


# =============================================================================
# vox-bridge
# =============================================================================

# --- Bridge runtime ----------------------------------------------------------
# [optional] Default 3000. Also read by core as a bind fallback, so set it per service.
# PORT=3000
# [optional] Core API base URL. Default http://127.0.0.1:3001
VOX_CORE_URL=http://core-api:3001
# [optional] Agent used for conversations. Default general.
VOX_AGENT_KEY=general

# --- Authenticated access to core (all [required]) ---------------------------
# Host credential registered in core (POST /v1/host-apps). The ID is a UUID.
VOX_HOST_CREDENTIAL_ID=
VOX_HOST_AUDIENCE=
VOX_HOST_SECRET=

# --- Twilio telephony ---------------------------------------------------------
# [required]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# [required] Number calls are placed from and received on (E.164).
TWILIO_FROM_NUMBER=
# [optional] WhatsApp phone verification through Twilio. TWILIO_WHATSAPP_FROM is the registered
# WhatsApp sender (E.164); TWILIO_OTP_CONTENT_SID is the HX... id of the approved
# "WhatsApp authentication" template from Twilio's Content Template Builder.
# Verification returns 503 when either is unset.
TWILIO_WHATSAPP_FROM=
TWILIO_OTP_CONTENT_SID=

# --- Speech ------------------------------------------------------------------
# ASSEMBLYAI_API_KEY [required], VOX_TTS_PROVIDER, ELEVENLABS_* and JEV_API_KEY are in the shared section.
# [optional] Only assemblyai is supported.
VOX_STT_PROVIDER=assemblyai
# [optional] Streaming model. Default universal-3-5-pro. Set per service (core reads the same name).
# ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
# [optional] Turn detection in ms (defaults 200 / 400) and comma-separated vocabulary boost.
ASSEMBLYAI_MIN_TURN_SILENCE=200
ASSEMBLYAI_MAX_TURN_SILENCE=400
ASSEMBLYAI_WORD_BOOST=
# [required when VOX_TTS_PROVIDER=sarvam]
SARVAM_API_KEY=
# Voice for the spoken "I'm looking into that" fillers. Unset uses the main voice.
ELEVENLABS_FILLER_VOICE_ID=
# [optional] Alias of JEV_API_KEY for the bridge only; wins over it when both are set.
# TYPESAFE_API_KEY=

# --- WhatsApp Cloud API (optional, inbound WhatsApp webhooks and replies) ----
WA_VERIFY_KEY=
META_APP_SECRET=
WHATSAPP_ACCESS_KEY=
WHATSAPP_PHONE_ID=

# --- Testing -----------------------------------------------------------------
# Set to 1 or true to allow tests to use paid Twilio, WhatsApp and ElevenLabs APIs. Never in production.
VOX_LIVE_CHANNEL_TEST=


# =============================================================================
# Development and tests only (not read at runtime)
# =============================================================================
# Isolated Postgres for the #[ignore]d database tests in vox-core.
# TEST_DATABASE_URL=
